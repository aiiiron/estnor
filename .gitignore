# Deployment settings (base_path) — copy config.example.php to config.php.
/config.php

# Reference project content (photos AND .txt info files) — edited
# straight on the server (FTP / file manager) per project folder, see
# assets/img/references/README.md. NONE of it is tracked here, on
# purpose: deploying this site re-syncs every git-tracked file from
# this repo, which would silently overwrite anything edited on the
# live server the same way photos are — a .txt file used to be a
# tracked exception to that and got wiped by a deploy for exactly that
# reason. (Ignoring only files inside each folder, not the folder
# itself, so git still tracks the per-project folders via their
# .gitkeep — empty placeholders, never real content.)
/assets/img/references/*/*
!/assets/img/references/*/.gitkeep
